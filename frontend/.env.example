# Supabase Public Configuration for TICORE Frontend
# Copy this file to .env.local and replace with your actual Supabase project credentials.
# Do NOT place your Supabase service_role key here. Only use the publishable / anon key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
